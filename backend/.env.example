# Copy this file to `.env` and fill in real values for local development.
# Spring Boot does not read .env files automatically: export these as
# environment variables before running the app, e.g.
#   export $(grep -v '^#' .env | xargs) && ./mvnw spring-boot:run
# or configure them as environment variables in your IDE run configuration.

# Active Spring profile (dev, test, prod)
APP_PROFILE=dev

# PostgreSQL connection used by the "dev" profile (see application-dev.properties)
DB_URL=jdbc:postgresql://localhost:5432/dsvendas
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Used by the "prod" profile (see application-prod.properties)
# DATABASE_URL=postgres://user:password@host:5432/dbname
